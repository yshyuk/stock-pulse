<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  2차 분석 launchd agent — 배치(06:00)가 만든 리포트를 Claude Code CLI 로 해석한다.

  배치와 분리한 이유:
    - claude CLI 는 Max 구독을 쓴다. jar 안의 AnthropicReportAnalyzer 는 API 종량제다.
    - 프롬프트를 jar 재빌드 없이 고칠 수 있다.
    - 분석이 실패해도 리포트는 이미 생성·발송된 뒤라 배치 신뢰도에 영향이 없다.

  설치 (스크립트를 ~/apps 로 복사하는 단계가 필수):
    mkdir -p ~/apps/stock-pulse
    cp deploy/analyze-report.sh deploy/analysis-prompt.md ~/apps/stock-pulse/
    chmod +x ~/apps/stock-pulse/analyze-report.sh
    cp deploy/com.stockpulse.analyze.plist ~/Library/LaunchAgents/
    # 아래 REPLACE_ME 를 채운 뒤
    launchctl unload ~/Library/LaunchAgents/com.stockpulse.analyze.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.stockpulse.analyze.plist
    launchctl start  com.stockpulse.analyze     # 1회 수동 실행해 확인

  왜 레포가 아니라 ~/apps 에서 실행하는가:
    ~/Documents 는 macOS 가 보호하는 폴더(TCC)라 launchd 에이전트가 읽지 못한다.
    파일 권한이 -rwxr-xr-x 여도 exit 126 + "Operation not permitted" 로 죽는다.
    배치(jar)가 ~/apps 에서 도는 것과 같은 이유이며, 레포를 옮기거나 /bin/bash 에
    전체 디스크 접근을 주는 것보다 산출물만 내보내는 편이 안전하다.

  주의: launchd 는 로그인 셸이 아니라 PATH 가 최소다. claude 경로를 절대경로로 준다.
        키체인 접근이 막혀 인증이 실패할 수 있으므로 반드시 1회 수동 실행으로 확인할 것.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockpulse.analyze</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/REPLACE_ME_USERNAME/apps/stock-pulse/analyze-report.sh</string>
    </array>

    <!-- claude 는 cwd 를 읽을 수 있어야 시작한다. ~/Documents 는 TCC 로 막히므로 ~/apps 를 쓴다. -->
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME_USERNAME/apps/stock-pulse</string>

    <!-- 배치(06:00)가 끝난 뒤. 전종목 수집이 약 20초이므로 10분이면 충분하다. -->
    <!-- 여러 시각에 호출한다. 멈춤은 구간 단위여서(2026-10-05 에 8분 30초 동안 3회 모두
         멈춤) 한 실행 안에서 재시도를 늘려봐야 같은 구간에 머문다. 시간을 벌려야 한다.

         이미 그날 분석이 있으면 스크립트가 즉시 종료하므로 중복 발송은 없다.
         1차에 성공하면 07:10·09:10 호출은 아무것도 하지 않는다. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- claude CLI 절대경로.
             `~/.local/bin/claude` 는 심볼릭 링크이고 claude 는 저절로 업데이트된다
             (2026-09-15 → 09-24 → 09-27 → 10-02 네 번 바뀜). 대화형 세션이 업데이트하면
             무인 배치가 쓰는 바이너리도 같이 바뀐다.

             버전을 고정하려면 링크 대신 버전 경로를 직접 넣는다:
               /Users/REPLACE_ME_USERNAME/.local/share/claude/versions/2.1.287
             단, 업데이터가 옛 버전을 정리하면 그 경로가 사라진다. 사라지면 스크립트가
             시작 시점에 실패하며 알리므로 조용히 깨지지는 않는다.

             고정하지 않아도 스크립트가 매 실행 버전을 로그와 분석 파일에 남긴다. -->
        <key>CLAUDE_BIN</key>
        <string>/Users/REPLACE_ME_USERNAME/.local/bin/claude</string>

        <!-- 기대하는 claude 버전(선택). 지정하면 실제 버전이 다를 때 로그로 알린다.
             실패시키지는 않는다 — 버전이 올라간 것만으로 그날 분석을 버릴 이유는 없다. -->
        <!--
        <key>ANALYSIS_CLAUDE_VERSION</key>
        <string>2.1.287</string>
        -->


        <!-- `claude setup-token` 으로 발급한 장수명 토큰.
             claude 의 OAuth 세션은 만료되며, 만료되면 아무 설명 없이 exit 1 로 죽는다.
             ANTHROPIC_API_KEY 를 쓰면 안 된다 — 그쪽은 API 종량제라 구독을 쓰지 않는다. -->
        <key>ANTHROPIC_AUTH_TOKEN</key>
        <string>REPLACE_ME</string>

        <!-- 배치의 STOCKPULSE_REPORT_DIR 와 같아야 한다. -->
        <key>STOCKPULSE_REPORT_DIR</key>
        <string>/Users/Shared/stock-pulse/reports</string>

        <!-- 배치 plist 와 같은 값. 비우면 분석 결과가 파일로만 남는다. -->
        <key>TELEGRAM_BOT_TOKEN</key>
        <string>REPLACE_ME</string>
        <key>TELEGRAM_CHAT_ID</key>
        <string>REPLACE_ME</string>

        <!-- 배치 plist 와 같은 값. 비우면 디스코드로는 보내지 않는다. -->
        <key>DISCORD_WEBHOOK_URL</key>
        <string>REPLACE_ME</string>

        <!-- claude 가 응답하지 않을 때 끊는 시간(초).
             **여기에 값을 넣지 않는 것을 권한다.** 스크립트 기본값(120)이 관측치에 맞춰
             정해져 있고, plist 값이 그 기본값을 덮는다. 성공은 전부 20~40초였고 멈춤은
             600초를 기다려도 회복된 적이 없다 — 늘리면 재시도만 늦어진다. -->
        <!--
        <key>ANALYSIS_TIMEOUT_SEC</key>
        <string>120</string>
        -->

        <!-- 배치가 끝날 때까지 기다릴 시간(초). 맥이 예약 시각에 자고 있으면 배치가
             늦게 끝나므로, 고정 시각에 한 번 보고 포기하면 그날 분석이 빠진다. -->
        <key>ANALYSIS_REPORT_WAIT_SEC</key>
        <string>1800</string>

        <key>HOME</key>
        <string>/Users/REPLACE_ME_USERNAME</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/Shared/stock-pulse/logs/analyze-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/stock-pulse/logs/analyze-stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
